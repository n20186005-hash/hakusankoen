---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import QuickFacts from '../components/QuickFacts.astro';
import ParkMap from '../components/ParkMap.astro';
import Notice from '../components/Notice.astro';
import ReviewBlock from '../components/ReviewBlock.astro';
import FaqSection from '../components/FaqSection.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import VisitorServices from '../components/VisitorServices.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import VisitorRoutes from '../components/VisitorRoutes.astro';
import HistoryLegend from '../components/HistoryLegend.astro';
import ScienceResponsibility from '../components/ScienceResponsibility.astro';
import { site, seasons, courseList, gourmetList, faqList } from '../data/site';

const touristSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${site.url}/#attraction`,
  name: '白山公園',
  alternateName: ['Hakusan Park', 'Hakusan Koen', '新潟 白山公園'],
  description: site.description,
  url: site.url,
  image: [`${site.url}/images/og-hakusan-koen.webp`],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '一番堀通町地先',
    addressLocality: '新潟市中央区',
    addressRegion: '新潟県',
    postalCode: site.entity.postalCode,
    addressCountry: site.entity.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.coordinates.lat,
    longitude: site.coordinates.lng,
  },
  hasMap: site.mapsShareUrl,
  sameAs: [site.mapsShareUrl, site.govtTourismUrl],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<BaseLayout schema={[touristSchema, faqSchema]}>
  <section class="home-hero">
    <picture class="hero-picture">
      <source media="(max-width: 639px)" srcset="/images/hero-mobile.webp" />
      <img src="/images/hero.webp" alt="新潟・白山公園のひょうたん池と桜" width="1600" height="1000" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-overlay"></div>
    <div class="container-wide hero-content">
      <div class="hero-title-wrap" data-reveal>
        <p class="hero-kicker">国指定名勝・新潟</p>
        <h1 class="serif"><span>白山公園（新潟市）を、</span><br/><span>ゆっくり歩く。</span></h1>
        <p>水と緑、神社と古町。<br/>明治から続く都市公園で、四季の時間に出会う。</p>
        <div class="hero-actions">
          <a class="button-primary" href="/highlights/">見どころを知る <Icon name="arrow" size={17}/></a>
          <a class="button-ghost" href="/courses/">散歩コースを見る <Icon name="walk" size={17}/></a>
        </div>
      </div>
      <div class="hero-side-note vertical-label" aria-hidden="true">HAKUSAN KŌEN · NIIGATA</div>
      <a class="hero-scroll" href="#intro" aria-label="下へスクロール"><span></span>SCROLL</a>
    </div>
  </section>

  <QuickFacts />

  <section class="editorial-section is-tinted" aria-labelledby="new-guides-title">
    <div class="container-wide">
      <div class="editorial-copy" data-reveal><p class="kicker">Explore More</p><h2 id="new-guides-title">白山公園をもっと歩く</h2><p>空中庭園の散策や、目的地に合わせた駐車場の選び方。来園前に役立つ詳しいガイドです。</p></div>
      <div class="card-grid two-up" style="margin-top:1.5rem">
        <a class="fact-card" href="/air-garden/"><p class="fact-label">SKY GARDENS</p><strong>空中庭園の見どころと歩き方 →</strong><p>文化施設と緑をつなぐ回廊、桜や紅葉、ルートのヒント。</p></a>
        <a class="fact-card" href="/parking-guide/"><p class="fact-label">PARKING GUIDE</p><strong>A〜D駐車場の選び方 →</strong><p>目的地別の区画選び、料金早見表、入庫・精算の注意。</p></a>
        <a class="fact-card" href="/nearby/"><p class="fact-label">NEARBY PLACES</p><strong>周辺の文化施設と見どころ →</strong><p>りゅーとぴあ、県民会館、音楽文化会館までの散策。</p></a>
      </div>
    </div>
  </section>

  <WeatherWidget />

  <section id="intro" class="section-space intro-section">
    <div class="container-wide intro-grid">
      <div class="intro-copy" data-reveal>
        <p class="kicker">A Park with 150 Years</p>
        <h2 class="section-title">日本の都市公園の<br/>はじまりを、今の街で。</h2>
        <p class="lead">白山公園は、1873年に認可された国内最初期の都市公園のひとつ。白山神社に隣り合い、ひょうたん池、蓮池、築山、石灯籠を巡る回遊式の庭園です。</p>
        <p class="entity-semantic">白山公園（Hakusan Park / Hakusan Koen）は、新潟県新潟市中央区にある、国指定名勝の都市公園です。</p>
        <p>春の桜、夏の蓮、秋の色づき、冬の雪景色。歴史を知る人にも、ただ静かに歩きたい人にも、季節ごとの居場所があります。</p>
        <a class="text-link" href="/about/">白山公園の歴史を読む <Icon name="arrow" size={17}/></a>
      </div>
      <div class="intro-collage" data-reveal>
        <figure class="image-frame intro-large"><img src="/images/summer-pond.webp" alt="緑に包まれた白山公園の池と噴水" width="1280" height="900" loading="lazy" /></figure>
        <figure class="image-frame intro-small"><img src="/images/garden-lantern.webp" alt="白山公園の池畔にある石灯籠" width="1280" height="900" loading="lazy" /></figure>
        <span class="collage-stamp serif">明治六年<br/>開園</span>
      </div>
    </div>
  </section>

  <ReviewBlock />

  <HistoryLegend />

  <section class="section-space season-section">
    <div class="container-wide">
      <SectionHeading kicker="Four Seasons" title="四季の景色を選んで歩く" description="花の時期だけでなく、水面の光、木陰、落葉、雪の静けさまで。白山公園は一年を通して表情を変えます。" />
      <div class="season-grid">
        {seasons.map((season, index) => (
          <a class="season-card" href={season.href} data-reveal>
            <figure class="image-frame"><img src={season.image} alt={`${season.name}の白山公園`} width="1280" height="900" loading="lazy" /></figure>
            <div class="season-index">0{index + 1}</div>
            <div class="season-copy">
              <p>{season.period} · {season.accent}</p>
              <h3 class="serif"><span>{season.name}</span>{season.title}</h3>
              <p>{season.description}</p>
              <span class="season-arrow"><Icon name="arrow" size={18}/></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SeasonalStrategy />

  <section class="section-space map-section">
    <div class="container-wide map-intro">
      <SectionHeading kicker="Garden & Culture" title="庭園、神社、文化施設をつなぐ" description="白山公園は、ひとつの門や一本の園路で完結しません。白山神社から歴史庭園、燕喜館、空中庭園へ、街の中をほどくように歩けます。" />
    </div>
    <div class="container-wide"><ParkMap /></div>
    <div class="container-wide location-block" data-reveal>
      <div class="location-embed">
        <iframe src={site.mapsEmbedSrc} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="白山公園のGoogleマップ"></iframe>
      </div>
      <div class="location-side">
        <p class="kicker">Location</p>
        <h3 class="serif location-title">新潟市中央区、白山神社のとなり。</h3>
        <p>緯度 {site.coordinates.lat}、経度 {site.coordinates.lng}。新潟市役所から徒歩約3分、JR白山駅から約20分の立地です。</p>
        <a class="button-secondary" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">Google マップで開く <Icon name="external" size={16} /></a>
        <a class="text-link" href={site.govtTourismUrl} target="_blank" rel="noopener noreferrer">新潟市公式サイト（観光情報） <Icon name="external" size={15} /></a>
      </div>
    </div>
  </section>

  <section class="section-space split-feature">
    <div class="container-wide feature-grid">
      <figure class="image-frame feature-image" data-reveal><img src="/images/hakusan-shrine.webp" alt="新潟総鎮守 白山神社の拝殿" width="1280" height="720" loading="lazy" /></figure>
      <div class="feature-copy" data-reveal>
        <p class="kicker">Hakusan Jinja</p>
        <h2 class="section-title">白山さまへ参り、<br/>庭園へ抜ける。</h2>
        <p>新潟総鎮守として親しまれる白山神社は、公園とひと続きの存在です。参拝のあとに梅林やひょうたん池へ向かうと、祈りの場から市民の庭へ、景色が自然に切り替わります。</p>
        <dl class="feature-list"><div><dt>楼門</dt><dd>季節や祭事で時間が変わります</dd></div><div><dt>所要</dt><dd>参拝と境内散策で約20–30分</dd></div><div><dt>組み合わせ</dt><dd>60分コースがおすすめ</dd></div></dl>
        <a class="button-secondary" href="/hakusan-jinja/">白山神社の案内 <Icon name="arrow" size={17}/></a>
      </div>
    </div>
  </section>

  <section class="section-space enkikan-section">
    <div class="container-wide enkikan-grid">
      <div class="enkikan-copy" data-reveal>
        <p class="kicker">Enkikan</p>
        <h2 class="section-title">庭を眺める、<br/>もうひとつの時間。</h2>
        <p>燕喜館は、明治期の商家・斎藤家の邸宅の一部を移築再建した文化施設。木の質感、座敷、庭の緑を近くに感じながら、歩く速度をいったん落とせます。</p>
        <p class="serif quote">「歩く」だけではない、<br/>白山公園の過ごし方。</p>
        <a class="text-link" href="/enkikan/">燕喜館を詳しく見る <Icon name="arrow" size={17}/></a>
      </div>
      <figure class="image-frame enkikan-image" data-reveal><img src="/images/enkikan.webp" alt="木々に囲まれた燕喜館の玄関" width="1280" height="900" loading="lazy" /><figcaption>登録有形文化財・燕喜館</figcaption></figure>
    </div>
  </section>

  <section class="section-space course-section">
    <div class="container-wide">
      <SectionHeading kicker="Walking Courses" title="時間に合わせて、歩幅を選ぶ" description="初めてなら60分。短い寄り道なら30分。文化施設まで楽しむなら120分。目的に合わせて無理なく巡れます。" />
      <div class="course-grid">
        {courseList.map((course, index) => (
          <article class="course-card card" data-reveal>
            <div class="course-top"><span>0{index + 1}</span><strong class="serif">{course.duration}</strong></div>
            <h3>{course.title}</h3><p>{course.summary}</p>
            <ol>{course.stops.map((stop) => <li>{stop}</li>)}</ol>
            <div class="course-bottom"><span><Icon name="walk" size={17}/>{course.pace}</span><a href="/courses/">詳細 <Icon name="arrow" size={16}/></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <VisitorRoutes />

  <section class="section-space gourmet-section">
    <div class="container-wide gourmet-layout">
      <div class="gourmet-heading"><SectionHeading kicker="After the Walk" title="散歩のあとに、新潟の一皿。" description="公園内の抹茶から、古町のラーメン、タレかつ丼まで。歩く距離と気分で選べる周辺の味をまとめました。" /><a class="button-secondary" href="/gourmet/">周辺グルメを見る <Icon name="arrow" size={17}/></a></div>
      <div class="gourmet-list">
        {gourmetList.slice(0, 4).map((item, index) => (
          <article data-reveal><span>0{index + 1}</span><div><p>{item.category} · {item.walk}</p><h3 class="serif">{item.name}</h3><p>{item.description}</p></div></article>
        ))}
      </div>
    </div>
  </section>

  <VisitorServices />

  <ScienceResponsibility />

  <FaqSection heading="よくある質問" />


  <section class="section-space-sm visit-section">
    <div class="container-wide visit-panel paper-panel" data-reveal>
      <div><p class="kicker">Plan Your Visit</p><h2 class="section-title">今日の白山公園へ。</h2><p>新潟駅からバス、市役所前から徒歩約3分。車ならA〜Dの駐車場を利用できます。</p></div>
      <div class="visit-actions"><a class="button-primary" href="/access/">アクセスを確認 <Icon name="train" size={18}/></a><a class="button-secondary" href="/parking/">駐車場を見る <Icon name="car" size={18}/></a></div>
      <Notice title="最新情報について"><p>開花、祭事、施設の利用時間、交通規制は変わる場合があります。訪問日が決まったら、各施設の最新案内も確認してください。</p></Notice>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; min-height: min(850px, calc(100svh - var(--header-height))); margin-top: calc(-1 * var(--header-height)); padding-top: var(--header-height); overflow: hidden; color: #fff; background: #173c32; }
  .hero-picture, .hero-picture img, .hero-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-picture img { object-fit: cover; object-position: center 46%; }
  .hero-overlay { background: linear-gradient(90deg, rgba(15,35,29,.82) 0%, rgba(15,35,29,.45) 48%, rgba(15,35,29,.1) 75%), linear-gradient(0deg, rgba(15,35,29,.35), transparent 45%); }
  .hero-content { position: relative; z-index: 2; min-height: inherit; display: flex; align-items: center; }
  .hero-title-wrap { max-width: 820px; padding-block: 8rem 9rem; }
  .hero-kicker { margin-bottom: 1.4rem; color: #f0d7d9; font-size: .75rem; font-weight: 700; letter-spacing: .22em; }
  .hero-title-wrap h1 { margin: 0 0 1.5rem; font-size: clamp(3.1rem,7.2vw,7.8rem); font-weight: 500; letter-spacing: .08em; line-height: 1.12; text-shadow: 0 4px 40px rgba(0,0,0,.25); }
  .hero-title-wrap h1 span:last-child { margin-left: clamp(0rem,7vw,7rem); }
  .hero-title-wrap > p:not(.hero-kicker) { margin-left: clamp(0rem,7vw,7rem); color: rgba(255,255,255,.82); font-size: clamp(.98rem,1.5vw,1.15rem); line-height: 2; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2rem; margin-left: clamp(0rem,7vw,7rem); }
  .hero-side-note { position: absolute; right: 0; top: 50%; color: rgba(255,255,255,.5); font-size: .62rem; font-weight: 700; }
  .hero-scroll { position: absolute; left: 0; bottom: 2.3rem; display: flex; align-items: center; gap: .8rem; color: rgba(255,255,255,.62); font-size: .57rem; letter-spacing: .18em; }
  .hero-scroll span { width: 48px; height: 1px; background: currentColor; }
  .intro-grid { display: grid; grid-template-columns: .88fr 1.12fr; align-items: center; gap: clamp(3rem,8vw,8rem); }
  .intro-copy > p:not(.kicker) { color: rgba(31,41,37,.68); line-height: 2; }.intro-copy .lead { margin-top: 1.4rem; color: rgba(31,41,37,.82); }
  .text-link { display: inline-flex; align-items: center; gap: .55rem; margin-top: 1rem; border-bottom: 1px solid rgba(23,60,50,.35); padding-bottom: .25rem; color: #173c32; font-size: .82rem; font-weight: 700; }
  .intro-collage { position: relative; min-height: 650px; }.intro-large { position: absolute; top: 0; right: 0; width: 78%; aspect-ratio: 4/5; }.intro-small { position: absolute; left: 0; bottom: 0; width: 48%; aspect-ratio: 4/3; border: 10px solid #f4f0e7; }.collage-stamp { position: absolute; left: 8%; top: 10%; z-index: 3; display: grid; width: 112px; height: 112px; place-items: center; border: 1px solid rgba(155,58,49,.35); border-radius: 50%; background: rgba(244,240,231,.9); color: #9b3a31; text-align: center; font-size: 1rem; line-height: 1.5; backdrop-filter: blur(8px); }
  .season-section { background: #ede8dc; }.season-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 2rem; margin-top: 3rem; }.season-card { position: relative; display: grid; grid-template-columns: 42% 1fr; min-height: 360px; overflow: hidden; border-radius: 28px; background: #fbfaf6; box-shadow: var(--shadow-card); }.season-card figure { border-radius: 0; }.season-index { position: absolute; top: 1.4rem; left: 1.4rem; z-index: 2; display: grid; width: 40px; height: 40px; place-items: center; border-radius: 50%; background: rgba(251,250,246,.85); color: #9b3a31; font-size: .68rem; font-weight: 700; backdrop-filter: blur(6px); }.season-copy { position: relative; display: flex; flex-direction: column; justify-content: center; padding: 2rem; }.season-copy > p:first-child { color: #9b3a31; font-size: .66rem; font-weight: 700; letter-spacing: .1em; }.season-copy h3 { margin: .6rem 0 1rem; color: #173c32; font-size: clamp(1.35rem,2.4vw,2rem); font-weight: 500; line-height: 1.5; }.season-copy h3 span { display: block; color: #9b3a31; font-size: .78rem; font-family: var(--font-sans); letter-spacing: .15em; }.season-copy > p:last-of-type { color: rgba(31,41,37,.62); font-size: .82rem; line-height: 1.8; }.season-arrow { position: absolute; right: 1.7rem; bottom: 1.7rem; color: #173c32; }
  .map-section { background: #fbfaf6; }.map-intro { margin-bottom: 3rem; }
  .split-feature { background: #173c32; color: #fff; }.feature-grid { display: grid; grid-template-columns: 1.12fr .88fr; align-items: center; gap: clamp(3rem,8vw,8rem); }.feature-image { min-height: 600px; }.feature-copy .kicker { color: #d7aaad; }.feature-copy .section-title { color: #fff; }.feature-copy > p { color: rgba(255,255,255,.68); line-height: 2; }.feature-list { margin: 2rem 0; }.feature-list div { display: grid; grid-template-columns: 100px 1fr; gap: 1rem; border-top: 1px solid rgba(255,255,255,.12); padding: .85rem 0; }.feature-list div:last-child { border-bottom: 1px solid rgba(255,255,255,.12); }.feature-list dt { color: #d7aaad; font-size: .75rem; font-weight: 700; }.feature-list dd { margin: 0; color: rgba(255,255,255,.72); font-size: .82rem; }.feature-copy .button-secondary { border-color: rgba(255,255,255,.28); background: rgba(255,255,255,.06); color: #fff; }
  .enkikan-section { background: #eee9dd; }.enkikan-grid { display: grid; grid-template-columns: .78fr 1.22fr; align-items: center; gap: clamp(3rem,8vw,8rem); }.enkikan-copy > p { color: rgba(31,41,37,.67); line-height: 2; }.enkikan-copy .quote { margin: 2.5rem 0 1.5rem; color: #9b3a31; font-size: clamp(1.3rem,2.7vw,2rem); line-height: 1.7; }.enkikan-image { aspect-ratio: 16/11; }.enkikan-image figcaption { position: absolute; right: 1.2rem; bottom: 1rem; border-radius: 999px; background: rgba(23,60,50,.76); color: #fff; padding: .45rem .75rem; font-size: .62rem; backdrop-filter: blur(8px); }
  .course-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; margin-top: 3rem; }.course-card { padding: 1.8rem; }.course-top { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(23,60,50,.1); padding-bottom: 1rem; }.course-top span { color: #9b3a31; font-size: .68rem; font-weight: 700; }.course-top strong { color: #173c32; font-size: 1.4rem; font-weight: 600; }.course-card h3 { margin: 1.4rem 0 .7rem; color: #173c32; font-size: 1.2rem; }.course-card > p { color: rgba(31,41,37,.62); font-size: .82rem; line-height: 1.8; }.course-card ol { margin: 1.2rem 0; padding: 0; list-style: none; counter-reset: stops; }.course-card li { position: relative; counter-increment: stops; padding: .45rem 0 .45rem 1.7rem; color: rgba(31,41,37,.72); font-size: .78rem; }.course-card li::before { content: counter(stops); position: absolute; left: 0; top: .45rem; display: grid; width: 20px; height: 20px; place-items: center; border: 1px solid rgba(155,58,49,.35); border-radius: 50%; color: #9b3a31; font-size: .55rem; }.course-card li:not(:last-child)::after { content: ''; position: absolute; left: 9px; top: 24px; width: 1px; height: 14px; background: rgba(155,58,49,.2); }.course-bottom { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(23,60,50,.1); padding-top: 1rem; color: #173c32; font-size: .72rem; font-weight: 700; }.course-bottom span, .course-bottom a { display: inline-flex; align-items: center; gap: .4rem; }
