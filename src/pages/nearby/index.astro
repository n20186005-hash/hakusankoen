---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
const places = [
 {title:'りゅーとぴあ 新潟市民芸術文化会館',href:'/nearby/ryutopia/',label:'舞台芸術と屋上・空中庭園',image:'/images/ryutopia-exterior.jpg',alt:'りゅーとぴあの建物外観'},
 {title:'新潟県民会館',href:'/nearby/niigata-kenminkaikan/',label:'震災復興と県民文化のホール',image:'/images/niigata-kenminkaikan-exterior.jpg',alt:'新潟県民会館の建物外観'},
 {title:'新潟市音楽文化会館',href:'/nearby/ongaku-bunka-kaikan/',label:'1977年開館の市民音楽施設',image:'/images/ongaku-bunka-kaikan-exterior.jpg',alt:'新潟市音楽文化会館の建物外観'},
 {title:'新潟県政記念館',href:'/nearby/niigata-prefectural-assembly-hall/',label:'1883年の議事堂建築・現在は保存修理で休館中',image:'/images/niigata-prefectural-assembly-hall.jpg',alt:'新潟県政記念館の白い擬洋風建築'},
 {title:'旧齋藤家別邸',href:'/nearby/saito-villa/',label:'1918年の豪商別邸と国指定名勝庭園',image:'/images/saito-villa-exterior.jpg',alt:'旧齋藤家別邸の建物外観'},
 {title:'新潟市美術館',href:'/nearby/niigata-city-art-museum/',label:'前川國男設計の美術館と屋外彫刻',image:'/images/niigata-city-art-museum.jpg',alt:'新潟市美術館の外観'},
 {title:'砂丘館',href:'/nearby/sakyukan/',label:'旧日本銀行支店長役宅・無料の建物見学',image:'/images/sakyukan-exterior.jpg',alt:'砂丘館の建物外観'},
 {title:'白山公園 空中庭園',href:'/air-garden/',label:'水辺と緑を結ぶ空中回廊',image:'/images/air-garden-sakura.webp',alt:'白山公園の空中庭園'},
 {title:'白山神社',href:'/hakusan-jinja/',label:'境内と歴史庭園をつなぐ',image:'/images/hakusan-shrine.webp',alt:'白山神社の拝殿'},
 {title:'燕喜館',href:'/enkikan/',label:'明治期の商家文化と庭園',image:'/images/enkikan.webp',alt:'燕喜館の実景'},
];
---
<BaseLayout title="白山公園の周辺スポット10選｜新潟の建築・庭園・文化施設" description="白山公園から巡る周辺スポット10選。りゅーとぴあ、県政記念館、旧齋藤家別邸、新潟市美術館、砂丘館などの歴史・建築・アクセスを紹介。">
 <Breadcrumbs items={[{label:'周辺スポット'}]}/>
 <PageHero kicker="Nearby Places" title="白山公園の周辺スポット" description="庭園の緑から音楽と舞台芸術の街へ。公園周辺の文化施設を、歴史と立ち寄り方とともに紹介します。" image="/images/air-garden-sakura.webp" imageAlt="白山公園の空中庭園"/>
 <section class="editorial-section is-tinted"><div class="container-wide"><div class="editorial-copy"><p class="kicker">Explore</p><h2>近くで立ち寄りたい10の場所</h2><p>白山公園のすぐ隣から、西大畑の近代建築・庭園エリアまで。休館・改修中の施設もあるため、入館できる場所と外観のみの場所を分けて計画してください。</p></div><div class="card-grid two-up" style="margin-top:2rem">{places.map(place=><a class="fact-card" href={place.href}><figure class="image-frame" style="margin-bottom:1rem;aspect-ratio:16/9"><img src={place.image} alt={place.alt} width="1280" height="720" loading="lazy"/></figure><p class="fact-label">NEARBY</p><strong>{place.title} →</strong><p>{place.label}</p></a>)}</div></div></section>
 <section class="editorial-section"><div class="container-reading editorial-copy"><h2>回り方のヒント</h2><p>近距離なら白山神社と歴史庭園から燕喜館、空中庭園、りゅーとぴあ方面へ。半日歩ける日は古町から西大畑へ向かい、旧齋藤家別邸・砂丘館・新潟市美術館の建築を比べてみましょう。県政記念館は長期休館中のため、入館の予定には組み込めません。</p><p><a class="text-link" href="/access/">新潟駅・白山駅からのアクセス →</a>　<a class="text-link" href="/parking-guide/">A〜D駐車場の選び方 →</a></p></div></section>
</BaseLayout>
