---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container-wide footer-top">
    <div class="footer-intro">
      <p class="kicker">Hakusan Kōen</p>
      <h2 class="serif">新潟のまんなかで、<br/>四季と歴史を歩く。</h2>
      <p>白山公園と周辺を、自分の歩幅で楽しむための非公式ガイドです。</p>
    </div>
    <div class="footer-links">
      <div>
        <p class="footer-label">園内を知る</p>
        <a href="/highlights/">見どころ</a><a href="/seasons/">四季</a><a href="/sakura/">桜の楽しみ方</a><a href="/courses/">散歩コース</a>
      </div>
      <div>
        <p class="footer-label">旅を整える</p>
        <a href="/access/">アクセス</a><a href="/parking/">駐車場</a><a href="/gourmet/">周辺グルメ</a><a href="/faq/">よくある質問</a>
      </div>
      <div>
        <p class="footer-label">このサイト</p>
        <a href="/about/">白山公園の歴史</a><a href="/credits/">写真・資料</a><a href="/privacy/">プライバシー</a>
      </div>
    </div>
  </div>
  <div class="container-wide footer-bottom">
    <p>© {new Date().getFullYear()} {site.domain}</p>
  </div>
</footer>
<style>
  .site-footer { overflow: hidden; background: #173c32; color: rgba(255,255,255,.82); }
  .footer-top { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(3rem, 9vw, 8rem); padding-block: clamp(72px,10vw,120px); }
  .footer-intro .kicker { color: #d7aaad; }
  .footer-intro h2 { margin: 1.4rem 0; color: #fff; font-size: clamp(2rem,4.5vw,4rem); font-weight: 500; line-height: 1.45; letter-spacing: .08em; }
  .footer-intro > p:last-child { max-width: 520px; color: rgba(255,255,255,.62); }
  .footer-links { display: grid; grid-template-columns: repeat(3,1fr); gap: 2rem; align-content: end; }
  .footer-links div { display: grid; align-content: start; gap: .65rem; }
  .footer-label { margin-bottom: .35rem; color: #d7aaad; font-size: .68rem; font-weight: 700; letter-spacing: .13em; }
  .footer-links a { font-size: .83rem; color: rgba(255,255,255,.75); transition: color .18s ease, transform .18s ease; }
  .footer-links a:hover { color: #fff; transform: translateX(3px); }
  .footer-bottom { display: flex; justify-content: flex-end; gap: 1rem; border-top: 1px solid rgba(255,255,255,.12); padding-block: 1.4rem; color: rgba(255,255,255,.48); font-size: .68rem; letter-spacing: .08em; }
  .footer-bottom p { margin: 0; }
  @media (max-width: 900px) { .footer-top { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .footer-links { grid-template-columns: 1fr 1fr; } }
</style>
