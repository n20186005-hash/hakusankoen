---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PageHero from './PageHero.astro';
import Notice from './Notice.astro';

interface Props {
  title:string; english:string; tagline:string; description:string; address:string;
  image:string; imageAlt:string; manager:string; history:string; architecture:string;
  feature:string; hours:string; admission:string; access:string; photograph:string;
  route:(string|{title:string;detail:string})[]; tips:string[]; faq:{q:string;a:string}[]; official:string;
  parking?:string; visitAdvice?:string; photoSource?:string;
}
const p = Astro.props;
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${p.title} ${p.address}`);
const schema = [
  {'@context':'https://schema.org','@type':'TouristAttraction',name:p.title,description:p.description,address:{'@type':'PostalAddress',streetAddress:p.address,addressLocality:'新潟市中央区',addressRegion:'新潟県',addressCountry:'JP'},hasMap:mapUrl},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:p.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
];
---
<BaseLayout title={`${p.title}｜白山公園周辺の見どころ・アクセス・駐車場`} description={p.description} schema={schema}>
  <Breadcrumbs items={[{label:'周辺スポット',href:'/nearby/'},{label:p.title}]} />
  <PageHero kicker={p.english} title={p.title} description={p.tagline} image={p.image} imageAlt={p.imageAlt}/>
  <section class="editorial-section is-tinted"><div class="container-reading editorial-copy"><p class="kicker">About {p.english}</p><h2>{p.title}について</h2><p>{p.manager}</p><p>{p.history}</p></div></section>
  <section class="editorial-section"><div class="container-wide facts-grid">
    <div class="fact-card"><p class="fact-label">HOURS</p><strong>{p.hours}</strong><p>当日の公開状況は公式案内で確認</p></div>
    <div class="fact-card"><p class="fact-label">TICKETS</p><strong>{p.admission}</strong><p>展示・催事ごとの条件を確認</p></div>
    <div class="fact-card"><p class="fact-label">LOCATION</p><strong>白山公園周辺</strong><p>{p.address}</p></div>
  </div></section>
  <section class="editorial-section is-tinted"><div class="container-wide content-grid"><article class="editorial-copy"><p class="kicker">Visiting Guide</p><h2>訪問する前に知っておきたいこと</h2><p>{p.description}</p><h3>見学の組み立て方</h3><p>{p.visitAdvice || '公園散策と施設見学を組み合わせるときは、公式サイトで公開時間と催事日程を先に確認しておくと安心です。'}</p><h3>交通と駐車場</h3><p>{p.parking || '公園周辺の駐車場は施設によって距離が異なります。'}</p><p><a href={p.official} target="_blank" rel="noopener noreferrer">施設の公式案内を確認する ↗</a></p></article><aside class="data-card sticky-aside"><div class="data-card-header"><h2>訪問の基本</h2></div><div class="data-card-body"><table class="info-table"><tbody><tr><th>住所</th><td>{p.address}</td></tr><tr><th>時間</th><td>{p.hours}</td></tr><tr><th>料金</th><td>{p.admission}</td></tr><tr><th>公共交通</th><td>{p.access}</td></tr><tr><th>車</th><td>{p.parking || <a href="/parking-guide/">白山公園駐車場の選び方</a>}</td></tr></tbody></table><a class="button-secondary" href={mapUrl} target="_blank" rel="noopener noreferrer" style="margin-top:1rem">{p.title}をGoogle マップで開く ↗</a></div></aside></div></section>
  <section class="editorial-section"><div class="container-wide content-grid is-reversed"><figure class="image-frame" style="max-width:800px"><img src={p.image} alt={p.imageAlt} width="800" height="500" loading="lazy" /></figure><article class="editorial-copy"><p class="kicker">History & Design</p><h2>歴史と建築を見る</h2><h3>歴史的背景</h3><p>{p.history}</p><h3>建築と空間</h3><p>{p.architecture}</p><h3>観察したいポイント</h3><p>{p.feature}</p></article></div></section>
  <section class="editorial-section is-tinted"><div class="container-wide content-grid"><article class="editorial-copy"><p class="kicker">Walking Itinerary</p><h2>白山公園と組み合わせる歩き方</h2><ol class="numbered-list">{p.route.map((step,i)=><li><h3>{i+1}. {typeof step==='string'?step:step.title}</h3><p>{typeof step==='string'?'当日の通行案内を確かめながら進みましょう。':step.detail}</p></li>)}</ol><h3>写真を撮るなら</h3><p>{p.photograph}</p>{p.photoSource && <p style="font-size:.75rem">掲載写真：<a href={p.photoSource} target="_blank" rel="noopener noreferrer">施設の公式写真ページ ↗</a></p>}</article><aside class="paper-panel" style="border-radius:24px;padding:1.5rem"><h3>訪問のヒント</h3><ul class="tip-list">{p.tips.map(t=><li>{t}</li>)}</ul></aside></div></section>
  <section class="editorial-section"><div class="container-reading editorial-copy"><p class="kicker">Questions</p><h2>よくある質問</h2>{p.faq.map(f=><div style="margin-bottom:1.6rem"><h3>{f.q}</h3><p>{f.a}</p></div>)}<Notice><p>施設の開館・チケット販売・イベント開催日程は変更される場合があります。訪問直前に<a href={p.official} target="_blank" rel="noopener noreferrer">施設の公式案内</a>で確認してください。</p></Notice><p style="margin-top:1.5rem"><a class="text-link" href="/nearby/">周辺スポット一覧 →</a>　<a class="text-link" href="/access/">白山公園への交通 →</a>　<a class="text-link" href="/air-garden/">空中庭園 →</a></p></div></section>
</BaseLayout>
