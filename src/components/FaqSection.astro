---
import Icon from './Icon.astro';
import { faqList } from '../data/site';

interface Props {
  heading?: string;
}
const { heading = 'よくある質問' } = Astro.props;
---
<section class="faq-home section-space">
  <div class="container-wide">
    <div class="faq-head">
      <p class="kicker">FAQ</p>
      <h2 class="section-title">{heading}</h2>
      <p>入園時間、料金、交通、季節、歩きやすさ。白山公園を安心して歩くための基本をまとめました。</p>
    </div>
    <div class="faq-stack">
      {faqList.map((item, index) => (
        <details class="faq-item" open={index === 0} data-reveal>
          <summary>{item.question}</summary>
          <div class="faq-answer"><p>{item.answer}</p></div>
        </details>
      ))}
    </div>
    <div class="faq-more">
      <a class="button-secondary" href="/faq/">すべての質問を見る <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .faq-home { background: #ede8dc; }
  .faq-head { max-width: 760px; margin-bottom: 2.4rem; }
  .faq-head .section-title { margin: .6rem 0 1rem; }
  .faq-head > p { color: rgba(31, 41, 37, .68); line-height: 2; }
  .faq-more { margin-top: 2rem; }
</style>
