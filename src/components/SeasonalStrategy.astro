---
import { seasonalStrategy } from '../data/site';
---

<section class="section-space seasonal-strategy">
  <div class="container-wide">
    <div class="ss-head">
      <p class="kicker">Seasonal Strategy</p>
      <h2 class="section-title">季節ごとの滞在戦略</h2>
      <p class="ss-sub">新潟は日本海側気候で、積雪と湿度の影響を強く受けます。以下は気象庁の平年値を目安とした季節の傾向です。訪問の時期選びや服装にご活用ください。</p>
    </div>
    <div class="ss-table-wrap">
      <table class="ss-table">
        <thead>
          <tr><th>季節</th><th>気象と服装</th><th>水辺の様子</th><th>動植物の見どころ</th></tr>
        </thead>
        <tbody>
          {seasonalStrategy.map((s) => (
            <tr>
              <th scope="row"><span class="ss-season">{s.season}</span><span class="ss-period">{s.period}</span></th>
              <td>{s.weather}</td>
              <td>{s.water}</td>
              <td>{s.wildlife}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .seasonal-strategy { background: #ede8dc; }
  .ss-head { max-width: 820px; margin-bottom: 2.4rem; }
  .ss-sub { margin-top: .9rem; color: rgba(31,41,37,.66); }
  .ss-table-wrap { overflow-x: auto; border: 1px solid rgba(23,60,50,.12); border-radius: 24px; background: #fbfaf6; box-shadow: var(--shadow-card); }
  .ss-table { width: 100%; min-width: 720px; border-collapse: collapse; }
  .ss-table th, .ss-table td { border-bottom: 1px solid rgba(23,60,50,.1); padding: 1.15rem 1.3rem; vertical-align: top; text-align: left; }
  .ss-table thead th { background: var(--color-moss); color: #fff; font-size: .74rem; letter-spacing: .08em; font-weight: 700; }
  .ss-table tbody tr:last-child th, .ss-table tbody tr:last-child td { border-bottom: 0; }
  .ss-season { display: block; color: var(--color-moss); font-family: var(--font-serif); font-size: 1.25rem; font-weight: 500; }
  .ss-period { display: block; margin-top: .3rem; color: var(--color-vermillion); font-size: .68rem; font-weight: 700; }
  .ss-table td { color: rgba(31,41,37,.74); font-size: .84rem; line-height: 1.85; }
</style>
