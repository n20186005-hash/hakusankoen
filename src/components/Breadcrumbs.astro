---
interface Item { label: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<nav class="breadcrumbs container-wide" aria-label="パンくずリスト">
  <ol>
    <li><a href="/">ホーム</a></li>
    {items.map((item) => <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}
  </ol>
</nav>
<style>
  .breadcrumbs { padding-top: 1.2rem; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: .45rem; margin: 0; padding: 0; list-style: none; color: rgba(31,41,37,.5); font-size: .68rem; letter-spacing: .08em; }
  .breadcrumbs li:not(:last-child)::after { content: '/'; margin-left: .45rem; opacity: .5; }
  .breadcrumbs a:hover { color: #173c32; }
</style>
